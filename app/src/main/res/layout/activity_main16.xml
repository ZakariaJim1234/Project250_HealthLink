<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity16">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha=".8"
        android:scaleType="fitXY"
        android:src="@drawable/b" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewSignUp27"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_margin="16dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EAE8E0"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewTitle27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/alegreya_sc_black"
                android:gravity="center"
                android:text="DELETE DATA"
                android:textColor="#141C1C"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/etx20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Doctor's name"
                android:inputType="text"
                android:textColor="@color/black" />


            <Button
                android:id="@+id/buttondelete2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#2E2E2C"
                android:fontFamily="@font/arbutus"
                android:text="DELETE"
                android:textColor="#F4EDED"
                android:textSize="20sp" />

            <Button
                android:id="@+id/show12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#2E2E2C"
                android:fontFamily="@font/arbutus"
                android:text="SHOW"
                android:textColor="#F4EDED"
                android:textSize="20sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>